# Copiar a .env y ajustar. Nunca subir .env al repositorio.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mu_realestate
# Mínimo 32 caracteres aleatorios. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
# Archivos: local (carpeta STORAGE_DIR) o s3 (DigitalOcean Spaces u otro compatible con S3)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=10
# Correo: dejar SMTP_HOST vacío en desarrollo para que los correos solo se escriban en el log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MU Real Estate <no-responder@murealestate.mx>
CODIGO_VERIFICACION_MINUTOS=15
