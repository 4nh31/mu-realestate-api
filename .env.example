# Copiar a .env y ajustar. Nunca subir .env al repositorio.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mu_realestate
# Mínimo 32 caracteres aleatorios. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]
