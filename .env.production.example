# Copiar a .env en el VPS y llenar. Nunca subir .env al repositorio.

# Dominio público ya apuntando a la IP del VPS (registro A). Caddy saca el certificado HTTPS solo.
DOMINIO=murealestate.mx

# Generar cada clave con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Front y API comparten dominio.
CORS_ORIGINS=["https://murealestate.mx"]
FRONTEND_URL=https://murealestate.mx
API_PUBLIC_URL=https://murealestate.mx

STORAGE_BACKEND=local
MAX_UPLOAD_MB=10

# Correo para los códigos de verificación y recuperación de contraseña.
# Con SMTP_HOST vacío los correos NO se envían (solo quedan en el log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MU Real Estate <no-responder@murealestate.mx>
CODIGO_VERIFICACION_MINUTOS=15
